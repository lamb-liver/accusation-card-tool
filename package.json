{
  "name": "accusation-v2",
  "private": true,
  "version": "0.0.0",
  "description": "《控訴》LCG 卡牌查詢、篩選與牌組構築輔助工具（PWA）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/project-cli.mjs dev",
    "build": "node scripts/project-cli.mjs build",
    "build:ci": "node scripts/project-cli.mjs build:ci",
    "check:assets": "node scripts/check-assets.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:public-orphans": "node scripts/check-public-orphans.mjs",
    "clean:public-orphans": "node scripts/clean-public-orphans.mjs",
    "check:deploy-flow": "node scripts/check-deploy-flow.mjs",
    "doctor:build-env": "node scripts/doctor-build-env.mjs",
    "check:pwa-sw": "node scripts/check-pwa-sw.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "npm run test:rule-engine && npm run test:card-catalog && npm run test:search && npm run test:deck && npm run test:clock && npm run test:utils && npm run test:share-wall",
    "test:rule-engine": "node scripts/test-rule-engine.mjs",
    "test:card-catalog": "node scripts/test-card-catalog.mjs",
    "test:search": "node scripts/test-search.mjs",
    "test:deck": "node scripts/test-deck.mjs",
    "test:deck-layout": "node scripts/test-deck-layout.mjs",
    "test:site-smoke": "node scripts/test-site-smoke.mjs",
    "test:clock": "node scripts/test-clock.mjs",
    "test:utils": "node scripts/test-utils.mjs",
    "validate:repo": "node scripts/project-cli.mjs validate:repo",
    "validate:browser": "node scripts/validate-browser.mjs",
    "audit:deck-layout": "node scripts/audit-deck-layout.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "fonts:display": "node scripts/build-display-font.mjs",
    "sync:qa": "node scripts/sync-qa.mjs",
    "cards:manifest": "node scripts/generate-card-manifest.mjs",
    "api:constants": "node scripts/generate-api-constants.mjs",
    "test:share-wall": "npm run api:constants && npm run cards:manifest && node scripts/test-share-wall.mjs",
    "cf:dev": "node scripts/project-cli.mjs cf:dev",
    "d1:migrations:apply:local": "node node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local",
    "d1:migrations:apply:remote": "node node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --remote",
    "port:check": "node scripts/project-cli.mjs port:check",
    "port:clean": "node scripts/project-cli.mjs port:clean",
    "preview": "node scripts/project-cli.mjs preview"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-glob": "^3.3.3",
    "globals": "^17.5.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.11",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.14.0"
  }
}
